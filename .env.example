# Firebase Web App konfigurācija (projekts: datorika-hub, lietotne: majas-skola)
# Iegūstiet šīs vērtības no Firebase Console -> Project Settings -> General -> Your apps -> majas-skola
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=datorika-hub.firebaseapp.com
FIREBASE_PROJECT_ID=datorika-hub
FIREBASE_STORAGE_BUCKET=datorika-hub.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

PORT=3000

# Neobligāti: dabaszinību augstas kvalitātes latviešu valodas balss.
# Google Cloud Text-to-Speech API jābūt ieslēgtam un norēķiniem konfigurētiem.
# Vides mainīgais ir SERVERA noslēpums; neatklāt frontend kodā.
GOOGLE_TTS_API_KEY=
